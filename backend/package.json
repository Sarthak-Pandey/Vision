{
  "name": "ai-impact-backend",
  "version": "1.0.0",
  "description": "AI Impact Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:nodemon": "nodemon --watch src -e ts --exec tsx src/server.ts",
    "build": "tsc",
    "start": "tsx watch src/server.ts",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx test-phase-5.ts && tsx test-phase-6.ts && tsx test-phase-7.ts && tsx test-phase-8.ts && tsx test-phase-9.ts && tsx test-regression.ts"
  },

  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "^2.48.1",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "vision-platform": "file:..",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
